{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CastGuard observable current-process quality input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "castguard-observable-quality-v1"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "observation_basis",
          "measurements"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "observation_basis": {
            "const": "same_completed_shot"
          },
          "measurements": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Velocity_1": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "Velocity_2": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "Velocity_3": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "High_Velocity": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "Cylinder_Pressure": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "Rapid_Rise_Time": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "Biscuit_Thickness": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "Clamping_Force": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "Cycle_Time": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "Pressure_Rise_Time": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "Casting_Pressure": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "Spray_Time": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "Spray_1_Time": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "Spray_2_Time": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "description": "All 14 finite current measurements required to score; missing/null explicitly abstains. No counters, labels, sensors, timestamps or history."
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "product_type": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "description": "Optional external product identity for warning only; never a model feature or inferred from quality files."
          }
        }
      }
    }
  }
}
